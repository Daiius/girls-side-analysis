FROM node:24-bookworm-slim AS build

WORKDIR /workdir

RUN corepack enable

# workspace ルートの依存定義。catalog: 参照の解決には catalog 定義を持つ
# pnpm-workspace.yaml が必須（これが無いと ERR_PNPM_CATALOG_ENTRY_NOT_FOUND）。
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server-ts/package.json server-ts/tsconfig.json server-ts/esbuild.config.ts ./server-ts/
# --frozen-lockfile はワークスペース全 package.json を要求するため next も含める
COPY next/package.json ./next/

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter @daiius/girls-side-analysis-server-ts

COPY server-ts/src/ ./server-ts/src/
# migrate.ts は dist/migrate.js としてバンドルされる（esbuild.config.ts の 2 本目）
COPY server-ts/migrate.ts ./server-ts/

RUN pnpm --filter @daiius/girls-side-analysis-server-ts build


FROM gcr.io/distroless/nodejs24-debian12:debug

WORKDIR /app

COPY ./server-ts/package.json /app
COPY --from=build /workdir/server-ts/dist/index.js /app/index.js

# マイグレーション。**使い捨てコンテナとして明示的に実行する**
# （起動時の自動適用にはしない ── 失敗時の挙動と、将来インスタンスを増やしたときの
#  競合が読めなくなるため。PRD 03 §5）。
#
#   docker run --rm --network <DB に届く network> --env-file <env> <image> migrate.js
#
# ⚠️ **`--network` は必須**。素の `docker run` は既定の bridge に入るので、
#    `DB_HOST` が別 network 上の名前（compose のサービス名など）だと解決できない。
#    dev の compose 環境なら `--network girls-side-analysis-network`。
# ⚠️ このイメージは distroless で **ENTRYPOINT が node** なので、渡すのは
#    **スクリプトのパスだけ**。`node /app/migrate.js` と書くと node を引数に取って落ちる。
COPY --from=build /workdir/server-ts/dist/migrate.js /app/migrate.js

# 生成済みの SQL。⚠️ **バンドルには含まれない**（migrator が実行時に fs で読むため）。
# migrator は migration.sql の無いフォルダを黙って読み飛ばすので、
# ここを忘れると「何も流さずに成功」する（PRD 03 §5.1）。
# migrate.js は cwd 相対で ./drizzle を読む＝ WORKDIR /app に置くこと。
COPY server-ts/drizzle/ /app/drizzle/

CMD ["index.js"]
