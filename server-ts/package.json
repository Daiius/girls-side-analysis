{
  "name": "@daiius/girls-side-analysis-server-ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsx esbuild.config.ts",
    "start": "node dist/index.js",
    "db:push": "drizzle-kit push --force --dialect=mysql --schema=src/db/schema.ts --host=$DB_HOST --user=$MYSQL_USER --password=$MYSQL_PASSWORD --database=$MYSQL_DATABASE",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx migrate.ts",
    "db:baseline": "tsx baseline.ts",
    "db:seed": "tsx addTestData.ts",
    "db:backfill": "tsx backfillDailyOshiCount.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "import": "./src/app.ts"
    },
    "./client": {
      "import": "./src/client.ts"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "catalog:",
    "drizzle-orm": "1.0.0-rc.3",
    "hono": "^4.13.13",
    "luxon": "catalog:",
    "mysql2": "^3.24.5",
    "node-cron": "^4.6.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "1.0.0-rc.3",
    "esbuild": "^0.28.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.12"
  }
}
